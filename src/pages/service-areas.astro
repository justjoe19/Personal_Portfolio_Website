---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Contact from '../components/Contact';
import Footer from '../components/Footer.astro';
import { areas, areaServed, cityPages } from '../data/areas';

const title = 'Michiana Service Areas: Mishawaka, South Bend, Elkhart & SW Michigan | Michiana Dev';
const description =
	'Michiana Dev builds custom websites and software for small businesses in Mishawaka, South Bend, Elkhart, Granger, Goshen, Niles, St. Joseph, and across Michiana.';

const groups = [
	{ title: 'Northern Indiana (St. Joseph, Elkhart, Marshall & LaPorte Counties)', cities: areas.filter((a) => a.state === 'IN') },
	{ title: 'Southwest Michigan (Berrien & Cass Counties)', cities: areas.filter((a) => a.state === 'MI') },
];

const links = [
	{ href: '/services', title: 'Services & packages', desc: 'Simple starter sites, full business websites, Google Business Profile setup, custom software, and hosting.' },
	{ href: '/contractors', title: 'Contractors & home services', desc: 'Lead-focused websites for roofing, restoration, HVAC, plumbing, remodeling, and local trades.' },
	{ href: '/restaurants', title: 'Restaurants & hospitality', desc: 'Mobile-friendly HTML menus (no pinched PDFs), hours, directions, and online ordering.' },
	{ href: '/small-business', title: 'Small businesses & B2B', desc: 'Professional offices, insurance, medical/dental clinics, local shops, and manufacturers.' },
];

const url = 'https://michiana.dev/service-areas';
const schema = JSON.stringify([
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${url}#page`,
		name: title,
		description,
		url,
		about: { '@id': 'https://michiana.dev/#business' },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		'@id': `${url}#service`,
		name: 'Web design and custom software development in Michiana',
		serviceType: 'Web design and development',
		url,
		provider: { '@id': 'https://michiana.dev/#business' },
		areaServed,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://michiana.dev/' },
			{ '@type': 'ListItem', position: 2, name: 'Service areas', item: url },
		],
	},
]);
---

<Layout title={title} description={description}>
	<script type="application/ld+json" is:inline set:html={schema} />

	<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-paper">Skip to main content</a>

	<Navbar client:load />

	<main id="main-content">
		<header class="relative overflow-hidden pt-36 pb-16 sm:pt-44 sm:pb-20">
			<div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(70%_60%_at_50%_30%,#000,transparent)]"></div>
			<div class="container-x relative max-w-4xl">
				<nav aria-label="Breadcrumb" class="text-[0.72rem] uppercase tracking-[0.16em] text-muted">
					<a href="/" class="hover:text-ink">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">Service areas</span>
				</nav>
				<p class="eyebrow mt-8">Northern Indiana &amp; Southwest Michigan</p>
				<h1 class="display mt-5 text-[clamp(2.4rem,6vw,5rem)]">
					<span class="text-fade">Serving Mishawaka, South Bend, Elkhart, and</span> <span class="serif-accent text-gradient pr-2">all of Michiana.</span>
				</h1>
				<p class="mt-7 max-w-2xl text-[clamp(1.05rem,1.6vw,1.2rem)] leading-relaxed text-body">
					I’m based in Mishawaka, Indiana (46544). I design and hand-build custom websites and software for small businesses across Northern Indiana and Southwest Michigan—and I also work with remote clients anywhere in the U.S.
				</p>
				<div class="mt-10 flex flex-col gap-3 sm:flex-row">
					<a href="#contact" class="btn-primary">Get a free website review</a>
					<a href="/services" class="btn-ghost">See services &amp; pricing</a>
				</div>
			</div>
		</header>

		<!-- Featured Michiana City Pages -->
		<section class="border-t border-line py-24 sm:py-32" aria-labelledby="featured-cities-heading">
			<div class="container-x">
				<div class="reveal max-w-3xl">
					<p class="eyebrow">Featured Local Markets</p>
					<h2 id="featured-cities-heading" class="display mt-5 text-[clamp(2.2rem,4.8vw,3.8rem)]">
						Explore web design by <span class="serif-accent text-gradient">Michiana city.</span>
					</h2>
					<p class="mt-4 text-lg leading-relaxed text-body">
						Select your city below to see local market details, nearby projects, and how I help businesses in your area rank and convert:
					</p>
				</div>

				<ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
					{cityPages.map((city) => (
						<li>
							<a href={`/service-areas/${city.slug}`} class="spotlight card reveal group flex h-full flex-col justify-between p-6">
								<div>
									<div class="flex items-center justify-between gap-2">
										<span class="text-[0.68rem] uppercase tracking-[0.14em] text-accent">{city.county}</span>
										<span class="text-xs text-muted">{city.stateFull}</span>
									</div>
									<h3 class="mt-2.5 text-2xl font-semibold tracking-tight text-ink group-hover:text-sky">
										{city.name}, {city.state}
									</h3>
									<p class="mt-2 text-xs font-medium text-leaf">{city.distanceNote}</p>
									<p class="mt-3 text-[0.92rem] leading-relaxed text-body">{city.intro}</p>
								</div>
								<div class="mt-6 border-t border-line pt-4">
									<span class="inline-flex items-center gap-1.5 text-sm font-semibold text-ink group-hover:text-sky">
										Web design in {city.name}
										<span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
									</span>
								</div>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- Full 20-Town Directory -->
		<section class="border-t border-line py-24 sm:py-32" aria-labelledby="areas-heading">
			<div class="container-x">
				<div class="reveal max-w-3xl">
					<p class="eyebrow">All 20 Michiana Communities</p>
					<h2 id="areas-heading" class="display mt-5 text-[clamp(2.2rem,4.8vw,3.8rem)]">
						Every town <span class="serif-accent text-gradient">I serve.</span>
					</h2>
				</div>
				<div class="mt-12 grid gap-4 md:grid-cols-2">
					{groups.map((g) => (
						<section class="spotlight card reveal p-7" aria-labelledby={`g-${g.title.replace(/\s+/g, '-').toLowerCase()}`}>
							<h3 id={`g-${g.title.replace(/\s+/g, '-').toLowerCase()}`} class="font-semibold tracking-tight text-ink">{g.title}</h3>
							<ul class="mt-5 flex flex-wrap gap-2">
								{g.cities.map((c) => (
									<li>
										{'slug' in c && c.slug ? (
											<a
												href={`/service-areas/${c.slug}`}
												class="inline-block rounded-full border border-line-strong bg-surface px-3.5 py-1.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-sky"
											>
												{c.name} →
											</a>
										) : (
											<span class="inline-block rounded-full border border-line bg-surface/60 px-3.5 py-1.5 text-sm font-medium text-body">
												{c.name}
											</span>
										)}
									</li>
								))}
							</ul>
						</section>
					))}
				</div>
				<p class="reveal mt-8 max-w-3xl text-body">
					Don’t see your town listed? If you’re anywhere in Northern Indiana, Southwest Michigan, or elsewhere in the U.S., <a href="#contact" class="link-arrow">get in touch</a>—I’m happy to talk through what your business needs.
				</p>
			</div>
		</section>

		<section class="border-t border-line py-24 sm:py-32" aria-labelledby="explore-heading">
			<div class="container-x">
				<div class="reveal max-w-3xl">
					<p class="eyebrow">What I build</p>
					<h2 id="explore-heading" class="display mt-5 text-[clamp(2.2rem,4.8vw,3.8rem)]">Explore by <span class="serif-accent text-gradient">industry &amp; service.</span></h2>
				</div>
				<ul class="mt-12 grid gap-4 sm:grid-cols-2">
					{links.map((l) => (
						<li>
							<a href={l.href} class="spotlight card reveal group flex h-full items-start justify-between gap-4 p-6">
								<span>
									<span class="block font-semibold tracking-tight text-ink group-hover:text-sky">{l.title}</span>
									<span class="mt-1.5 block text-[0.92rem] leading-relaxed text-muted">{l.desc}</span>
								</span>
								<span class="text-muted transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>

		<Contact client:visible />
	</main>

	<Footer />
</Layout>
