---
import { srcsetFor } from '../../lib/images';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [lead, ...rest] = posts;

const fmt = (d: Date) => d.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout
	title="Blog — Websites, Local SEO & Software for Service Businesses | Michiana Dev"
	description="Practical advice on websites, local SEO, and software for contractors and small businesses in South Bend, Mishawaka, Elkhart, and across Michiana."
	type="website"
>
	<Navbar client:load />

	<main class="pt-36 pb-24 sm:pt-44">
		<div class="container-x">
			<p class="eyebrow">The blog</p>
			<h1 class="display mt-5 max-w-4xl text-[clamp(2.8rem,7vw,5.6rem)]"><span class="text-fade">Notes on websites, SEO, and</span> <span class="serif-accent text-gradient">software.</span></h1>
			<p class="mt-6 max-w-2xl text-lg text-body">
				Plain-English advice for business owners on building a website and software that actually perform, from a studio in Mishawaka, Indiana.
			</p>

			{lead ? (
				<>
					<a href={`/blog/${lead.id}/`} class="group mt-16 grid gap-8 border-t border-line-strong pt-10 lg:grid-cols-[1.2fr_1fr] lg:items-center">
						{lead.data.heroImage && (
							<div class="overflow-hidden rounded-2xl border border-line">
								<img width={1024} height={512} src={lead.data.heroImage} srcset={srcsetFor(lead.data.heroImage)} sizes="(min-width: 1024px) 640px, 100vw" fetchpriority="high" alt={lead.data.heroImageAlt ?? lead.data.title} class="aspect-[2/1] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
							</div>
						)}
						<div>
							<p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted">Latest · {fmt(lead.data.pubDate)}</p>
							<h2 class="display mt-3 text-[clamp(2rem,3.6vw,2.8rem)] group-hover:text-sky">{lead.data.title}</h2>
							<p class="mt-4 leading-relaxed text-body">{lead.data.description}</p>
							<span class="link-arrow mt-6">Read article <span aria-hidden="true">→</span></span>
						</div>
					</a>

					<ul class="mt-16 grid gap-x-8 gap-y-14 border-t border-line pt-12 md:grid-cols-2 lg:grid-cols-3">
						{rest.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} class="group block">
									{post.data.heroImage && (
										<div class="overflow-hidden rounded-xl border border-line">
											<img width={720} height={360} loading="lazy" src={post.data.heroImage} srcset={srcsetFor(post.data.heroImage)} sizes="(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw" alt={post.data.heroImageAlt ?? post.data.title} class="aspect-[16/9] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
										</div>
									)}
									<p class="mt-5 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted">{fmt(post.data.pubDate)}</p>
									<h2 class="mt-2 text-xl font-semibold leading-snug text-ink group-hover:text-accent">{post.data.title}</h2>
									<p class="mt-2 line-clamp-3 text-[0.95rem] leading-relaxed text-body">{post.data.description}</p>
								</a>
							</li>
						))}
					</ul>
				</>
			) : (
				<p class="mt-16 text-body">No posts yet. Check back soon.</p>
			)}
		</div>
	</main>

	<Footer />
</Layout>
