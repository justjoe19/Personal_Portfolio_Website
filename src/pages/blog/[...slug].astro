---
import { srcsetFor } from '../../lib/images';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import BlogCTA from '../../components/BlogCTA.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

// Dynamic Blog Schema
const breadcrumbSchema = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://michiana.dev" },
		{ "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://michiana.dev/blog" },
		{ "@type": "ListItem", "position": 3, "name": post.data.title, "item": new URL(`/blog/${post.id}/`, Astro.site).toString() }
	]
});

const articleSchema = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": post.data.title,
	"description": post.data.description,
	"image": post.data.heroImage ? new URL(post.data.heroImage, Astro.site) : new URL("/assets/work/jhclaims.webp", Astro.site),
	"datePublished": post.data.pubDate.toISOString(),
	"dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
	"publisher": { "@type": "Organization", "name": "Michiana Dev LLC", "url": "https://michiana.dev" },
	"author": {
		"@type": "Person",
		"name": "Joe Hollenbach",
		"url": "https://michiana.dev"
	}
});

const fmt = (d: Date) => d.toLocaleDateString('en-us', { year: 'numeric', month: 'long', day: 'numeric' });
const words = (post.body ?? '').split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 230));
---

<Layout
	title={`${post.data.title} | Michiana Dev`}
	description={post.data.description}
	image={post.data.heroImage}
	type="article"
>
	<script type="application/ld+json" is:inline set:html={articleSchema} />
	<script type="application/ld+json" is:inline set:html={breadcrumbSchema} />

	<Navbar client:load />

	<main class="pt-36 pb-20 sm:pt-44">
		<article>
			<header class="container-x max-w-[820px]">
				<nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm text-muted">
					<a href="/" class="hover:text-ink">Home</a>
					<span aria-hidden="true">/</span>
					<a href="/blog" class="hover:text-ink">Blog</a>
				</nav>
				<h1 class="display mt-8 text-[clamp(2.4rem,5.5vw,4rem)]">{post.data.title}</h1>
				<p class="mt-6 text-lg leading-relaxed text-body">{post.data.description}</p>
				<div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 border-y border-line py-4 text-sm text-muted">
					<span class="font-semibold text-ink">Joe Hollenbach</span>
					<span aria-hidden="true">·</span>
					<time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
					{post.data.updatedDate && (
						<>
							<span aria-hidden="true">·</span>
							<span>Updated <time datetime={post.data.updatedDate.toISOString()}>{fmt(post.data.updatedDate)}</time></span>
						</>
					)}
					<span aria-hidden="true">·</span>
					<span>{minutes} min read</span>
				</div>
			</header>

			{post.data.heroImage && (
				<div class="container-x mt-10 max-w-[1000px]">
					<img width={1024} height={512} src={post.data.heroImage} srcset={srcsetFor(post.data.heroImage)} sizes="(min-width: 1040px) 1000px, 100vw" fetchpriority="high" alt={post.data.heroImageAlt ?? post.data.title} class="w-full rounded-2xl border border-line object-cover aspect-[2/1]" />
				</div>
			)}

			<div class="container-x mt-12 max-w-[720px]">
				<div class="blog-content">
					<Content />
				</div>
				<BlogCTA />
			</div>
		</article>
	</main>

	<Footer />
</Layout>

<style is:global>
	@reference "../../index.css";

	.blog-content {
		@apply text-[1.125rem] leading-[1.8] text-body;
	}
	.blog-content > * + * {
		@apply mt-6;
	}
	.blog-content h2 {
		@apply font-display font-semibold text-[1.9rem] leading-tight tracking-[-0.03em] text-ink mt-14;
	}
	.blog-content h3 {
		@apply text-xl font-semibold text-ink mt-10;
	}
	.blog-content ul {
		@apply list-disc pl-6 space-y-2 marker:text-accent;
	}
	.blog-content ol {
		@apply list-decimal pl-6 space-y-2 marker:text-muted marker:font-mono marker:text-sm;
	}
	.blog-content a {
		@apply text-sky underline decoration-sky/30 underline-offset-4 hover:decoration-sky;
	}
	.blog-content strong {
		@apply font-semibold text-ink;
	}
	.blog-content blockquote {
		@apply border-l-2 border-accent pl-5 font-serif italic text-2xl leading-snug text-ink;
	}
	.blog-content table {
		@apply w-full text-left text-base;
	}
	.blog-content th {
		@apply border-b border-line-strong py-2 pr-4 font-semibold text-ink;
	}
	.blog-content td {
		@apply border-b border-line py-2.5 pr-4 align-top;
	}
</style>
