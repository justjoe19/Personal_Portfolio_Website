---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero.astro';
import ServicesSummary from '../components/ServicesSummary.astro';
import WhoIWorkWith from '../components/WhoIWorkWith.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Pricing from '../components/Pricing.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import Faq from '../components/Faq.astro';
import { homeFaqs, faqSchema } from '../data/faqs';
import Contact from '../components/Contact';
import Footer from '../components/Footer.astro';

const faqs = homeFaqs;
const faqJson = JSON.stringify(faqSchema(faqs));
---

<Layout description="Local web and software studio in Mishawaka, IN. Fast, custom websites and software for South Bend and Michiana businesses. Websites start at $2,500." title="Websites & Software for Mishawaka & South Bend | Michiana Dev" isHome={true}>
	<script type="application/ld+json" is:inline set:html={faqJson} />

	<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-paper">Skip to main content</a>

	<Navbar client:load />

	<main id="main-content">
		<Hero />
		<WhoIWorkWith />
		<CaseStudies />
		<AboutTeaser />
		<ServicesSummary />
		<Pricing compact />
		<Faq faqs={faqs} />
		<Contact client:visible />
	</main>

	<Footer />
</Layout>
