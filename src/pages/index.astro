---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Craft from '../components/Craft.astro';
import RankRadius from '../components/RankRadius.astro';
import Work from '../components/Work.astro';
import Pricing from '../components/Pricing.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import Contact from '../components/Contact';
import Footer from '../components/Footer.astro';

const faqs: FaqItem[] = [
	{
		q: 'How much does a custom website cost?',
		a: 'A custom website is $500 for the first page, including the design and a contact form, plus $100 for each additional page, so a five-page site is $900. Features like a blog, online booking, or integrations are quoted after a free consultation, and you get a clear quote before any work starts. Custom software is quoted per project.',
	},
	{
		q: 'How long does it take to build a website?',
		a: 'Most small-business websites take 2–4 weeks from kickoff to launch, depending on scope and how quickly content and feedback come together. Custom software is scoped separately and delivered in milestones.',
	},
	{
		q: 'What’s included in the $100/month hosting and maintenance plan?',
		a: 'Secure hosting with an SSL certificate, regular backups, and up to one hour per month of minor content updates — things like swapping photos, editing text, or updating hours, prices, and service areas. New pages, new features, and redesigns are not included and are quoted separately.',
	},
	{
		q: 'What kinds of businesses do you work with?',
		a: 'Any business that wants a website or software product built to a high standard — professional firms, local service companies, startups, and established brands. I have deep experience with field-service companies like HVAC, roofing, plumbing, and restoration, which is why I built RankRadius for them.',
	},
	{
		q: 'What is RankRadius?',
		a: 'RankRadius is a local SEO platform I built and operate for field-service businesses. It pulls completed jobs from a company’s CRM, uses AI to turn short field notes into neighborhood-specific write-ups, matches them with Google reviews, and publishes them through a widget on the company’s own website. Learn more at rankradius.io.',
	},
	{
		q: 'Will I own my website?',
		a: 'Yes. You own your domain, your content, and the finished site.',
	},
	{
		q: 'Do you work with businesses outside Michiana?',
		a: 'Yes. I’m based in Mishawaka and work closely with businesses across South Bend, Elkhart, Granger, Goshen, and Niles — and I work with clients anywhere in the U.S. remotely.',
	},
];

const faqSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
});
---

<Layout title="Michiana Dev — Premium Custom Websites & Software | Mishawaka, Indiana" isHome={true}>
	<script type="application/ld+json" is:inline set:html={faqSchema} />

	<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-paper">Skip to main content</a>

	<Navbar client:load />

	<main id="main-content">
		<Hero />
		<Work />
		<Services />
		<RankRadius />
		<Craft />
		<Process />
		<Pricing />
		<About />
		<Faq faqs={faqs} />
		<Contact client:visible />
	</main>

	<Footer />
</Layout>
