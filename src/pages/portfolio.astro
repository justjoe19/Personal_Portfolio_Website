---
import { srcsetFor } from '../lib/images';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';
import BlogCTA from '../components/BlogCTA.astro';
import { projects } from '../data/projects';

const filters = [
	{ id: 'all', label: 'All Projects (6)' },
	{ id: 'Website', label: 'Client Websites' },
	{ id: 'Software', label: 'Custom Software' },
	{ id: 'Product', label: 'Products' },
];

const itemListSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Michiana Dev Portfolio',
	itemListElement: projects.map((p, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: p.name,
		description: p.summary,
		url: p.external ? p.href : new URL(p.href, 'https://michiana.dev').toString(),
	})),
});
---

<Layout
	title="Portfolio — Michiana Small Business Websites & Software | Michiana Dev"
	description="Client websites, custom software, and products hand-built by Michiana Dev in Mishawaka, IN, including TriStorm Restoration, JH Claims Solution, No Limit Roofing, and RankRadius."
>
	<script type="application/ld+json" is:inline set:html={itemListSchema} />
	<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-paper">Skip to main content</a>

	<Navbar client:load />

	<main id="main-content" class="pb-24">
		<header class="relative overflow-hidden pt-36 pb-16 sm:pt-44 sm:pb-20">
			<div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(70%_60%_at_50%_30%,#000,transparent)]"></div>
			<div class="container-x relative max-w-4xl">
				<nav aria-label="Breadcrumb" class="text-[0.72rem] uppercase tracking-[0.16em] text-muted">
					<a href="/" class="hover:text-ink">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">Portfolio</span>
				</nav>
				<h1 class="display mt-8 text-[clamp(2.4rem,6vw,5rem)]">
					<span class="text-fade">Built for real</span> <span class="serif-accent text-gradient pr-2">local businesses.</span>
				</h1>
				<p class="mt-7 max-w-2xl text-[clamp(1.05rem,1.6vw,1.2rem)] leading-relaxed text-body">
					Client websites, full-stack web applications, and software products I own and operate. Every project below was designed and hand-built from scratch in Mishawaka—no templates, no page builders.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href="/contact" class="btn-primary">Get a free website review</a>
					<a href="/services#pricing" class="btn-ghost">See packages &amp; pricing</a>
				</div>
			</div>
		</header>

		<div class="container-x">
			<div class="work-list">
				<fieldset class="flex flex-wrap gap-2 border-b border-line pb-8">
					<legend class="sr-only">Filter projects</legend>
					{filters.map((f, i) => (
						<label class="cursor-pointer">
							<input type="radio" name="work-filter" id={`f-${f.id}`} value={f.id} checked={i === 0} class="peer sr-only" />
							<span class="inline-block rounded-full border border-line px-4 py-2 text-sm text-muted transition-colors hover:text-ink peer-checked:border-transparent peer-checked:bg-ink peer-checked:text-paper peer-focus-visible:outline-2 peer-focus-visible:outline-accent">
								{f.label}
							</span>
						</label>
					))}
				</fieldset>

				<div class="divide-y divide-line">
					{projects.map((p, i) => (
						<article id={p.slug} data-kind={p.kind} class="reveal grid scroll-mt-28 gap-10 py-16 lg:grid-cols-2 lg:gap-16 lg:py-20">
							<div class:list={['spotlight card self-center overflow-hidden p-2.5', i % 2 === 1 && 'lg:order-2']}>
								<a href={p.href} {...(p.external ? { target: '_blank', rel: 'noopener' } : {})} class="group block overflow-hidden rounded-xl border border-line bg-sand/50" tabindex="-1" aria-hidden="true">
									<div class="flex items-center justify-between border-b border-line bg-sand/70 px-4 py-2.5">
										<div class="flex items-center gap-1.5">
											<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
											<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
											<span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
											{p.locationTag && <span class="ml-2 text-[0.66rem] text-muted">{p.locationTag}</span>}
										</div>
										{p.outcomePill && (
											<span class="rounded-full bg-leaf/12 px-2.5 py-0.5 text-[0.64rem] font-medium text-leaf">
												{p.outcomePill}
											</span>
										)}
									</div>
									<img
										src={p.image}
										srcset={srcsetFor(p.image)}
										sizes="(min-width: 1024px) 580px, 100vw"
										alt=""
										width={p.width}
										height={p.height}
										loading={i < 2 ? 'eager' : 'lazy'}
										fetchpriority={i === 0 ? 'high' : undefined}
										class="aspect-[16/10] w-full object-cover object-top transition-transform duration-[900ms] group-hover:scale-[1.04]"
									/>
								</a>
							</div>

							<div class="flex flex-col justify-center">
								<div class="flex flex-wrap items-center gap-2 text-[0.7rem] uppercase tracking-[0.16em] text-muted">
									<span class="text-accent">{p.kind}</span>
									<span>·</span>
									<span>{p.sector}</span>
								</div>
								<h2 class="display mt-3 text-[clamp(2.2rem,4vw,3.2rem)]">{p.name}</h2>
								<p class="mt-4 text-lg leading-relaxed text-body">{p.summary}</p>

								<dl class="mt-8 grid gap-6 sm:grid-cols-2">
									<div class="rounded-2xl border border-line bg-surface/50 p-5">
										<dt class="text-[0.68rem] uppercase tracking-[0.16em] text-muted">The business challenge</dt>
										<dd class="mt-2 text-[0.94rem] leading-relaxed text-body">{p.challenge}</dd>
									</div>
									<div class="rounded-2xl border border-line bg-surface/50 p-5">
										<dt class="text-[0.68rem] uppercase tracking-[0.16em] text-leaf">What I built</dt>
										<dd class="mt-2 text-[0.94rem] leading-relaxed text-body">{p.solution}</dd>
									</div>
								</dl>

								{p.result && (
									<p class="mt-6 border-l-2 border-leaf pl-3 text-[0.95rem] font-medium text-ink">{p.result}</p>
								)}

								{p.testimonial && (
									<figure class="mt-6 rounded-xl border border-line bg-paper p-5">
										<div class="mb-1.5 text-xs text-gold" aria-label="5 out of 5 stars">★★★★★</div>
										<blockquote class="text-[0.95rem] leading-relaxed text-ink">“{p.testimonial.quote}”</blockquote>
										<figcaption class="mt-3 flex flex-wrap items-center justify-between gap-2 text-sm text-body">
											<span>
												<span class="font-semibold text-ink">{p.testimonial.name}</span>
												{p.testimonial.role && <span>, {p.testimonial.role}</span>}
											</span>
											{p.testimonial.href && (
												<a href={p.testimonial.href} target="_blank" rel="noopener" class="link-arrow text-xs">
													Read on Google <span aria-hidden="true">↗</span>
												</a>
											)}
										</figcaption>
									</figure>
								)}

								<ul class="mt-8 space-y-2.5 border-t border-line pt-6">
									{p.highlights.map((h) => (
										<li class="flex gap-3 text-[0.95rem] text-ink">
											<span class="text-accent font-semibold" aria-hidden="true">✓</span>{h}
										</li>
									))}
								</ul>

								<div class="mt-8 flex flex-wrap items-center justify-between gap-4">
									<ul class="flex flex-wrap gap-2" aria-label="Capabilities">
										{p.stack.map((s) => (
											<li class="rounded-full border border-line bg-surface/60 px-3 py-1 text-[0.7rem] text-muted">{s}</li>
										))}
									</ul>
									<a href={p.href} {...(p.external ? { target: '_blank', rel: 'noopener' } : {})} class="btn-ghost !py-2.5 !text-sm">
										{p.linkLabel} <span aria-hidden="true">{p.external ? '↗' : '→'}</span>
									</a>
								</div>
							</div>
						</article>
					))}
				</div>
			</div>

			<div class="mx-auto max-w-[900px]">
				<BlogCTA />
			</div>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	/* Filtering with :has() — no JavaScript. */
	.work-list:has(#f-Website:checked) article:not([data-kind='Website']),
	.work-list:has(#f-Software:checked) article:not([data-kind='Software']),
	.work-list:has(#f-Product:checked) article:not([data-kind='Product']) {
		display: none;
	}
</style>
