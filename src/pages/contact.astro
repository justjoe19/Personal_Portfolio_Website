---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Contact from '../components/Contact';
import Footer from '../components/Footer.astro';

const title = 'Contact Michiana Dev | Free Website Review in Mishawaka, IN';
const description =
	'Request a free website review from Michiana Dev. Based in Mishawaka, IN, serving South Bend and Michiana. Call (574) 213-8502 or send a message.';

const steps = [
	{ n: '01', title: 'You send the details', desc: 'Tell me about your business and what you want the site or software to do.' },
	{ n: '02', title: 'I reply within 1–2 business days', desc: 'I’ll follow up to set up your free consultation.' },
	{ n: '03', title: 'We talk it through', desc: 'If you have a site, I’ll look at it and tell you honestly whether it needs fixing or rebuilding. Either way, we cover your business and what you need, and you leave with a clear scope.' },
	{ n: '04', title: 'You get a clear quote', desc: 'You see the quote before any work starts.' },
];

const url = 'https://michiana.dev/contact';
const schema = JSON.stringify([
	{
		'@context': 'https://schema.org',
		'@type': 'ContactPage',
		'@id': `${url}#page`,
		name: title,
		description,
		url,
		about: { '@id': 'https://michiana.dev/#business' },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://michiana.dev/' },
			{ '@type': 'ListItem', position: 2, name: 'Contact', item: url },
		],
	},
]);
---

<Layout title={title} description={description}>
	<script type="application/ld+json" is:inline set:html={schema} />

	<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-paper">Skip to main content</a>

	<Navbar client:load />

	<main id="main-content">
		<header class="relative overflow-hidden pt-36 pb-16 sm:pt-44 sm:pb-20">
			<div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(70%_60%_at_50%_30%,#000,transparent)]"></div>
			<div class="container-x relative max-w-4xl">
				<nav aria-label="Breadcrumb" class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-muted">
					<a href="/" class="hover:text-ink">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">Contact</span>
				</nav>
				<h1 class="display mt-8 text-[clamp(2.4rem,6vw,5rem)]">
					<span class="text-fade">Let’s talk about</span> <span class="serif-accent text-gradient pr-2">your website.</span>
				</h1>
				<p class="mt-7 max-w-2xl text-[clamp(1.05rem,1.6vw,1.2rem)] leading-relaxed text-body">
					I’m based in Mishawaka, Indiana, and I work with businesses across Michiana (see <a href="/service-areas" class="link-arrow">where I serve</a>) and with remote clients anywhere in the U.S. The consultation is free.
				</p>
			</div>
		</header>

		<section class="border-t border-line py-24 sm:py-32" aria-labelledby="next-heading">
			<div class="container-x">
				<div class="reveal max-w-3xl">
					<p class="eyebrow">What happens next</p>
					<h2 id="next-heading" class="display mt-5 text-[clamp(2.2rem,4.8vw,3.8rem)]">A simple <span class="serif-accent text-gradient">first step.</span></h2>
				</div>
				<ol class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
					{steps.map((s) => (
						<li class="spotlight bg-paper p-7">
							<span class="font-mono text-sm text-accent">{s.n}</span>
							<h3 class="mt-8 text-xl font-semibold">{s.title}</h3>
							<p class="mt-3 text-[0.95rem] leading-relaxed text-body">{s.desc}</p>
						</li>
					))}
				</ol>
			</div>
		</section>

		<Contact
			client:visible
			heading={['Send me', 'a message.']}
			intro="Fill out the form, call, or email. Websites start at $2,500, and the free website review comes with no obligation."
		/>
	</main>

	<Footer />
</Layout>
