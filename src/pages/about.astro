---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import About from '../components/About.astro';
import BlogCTA from '../components/BlogCTA.astro';
import Footer from '../components/Footer.astro';

const title = 'About Joe Hollenbach | Mishawaka Web & Software Developer';
const description =
	'Meet Joe Hollenbach, the software engineer behind Michiana Dev in Mishawaka, IN. You work directly with the person who designs and builds your site.';

const url = 'https://michiana.dev/about';
const schema = JSON.stringify([
	{
		'@context': 'https://schema.org',
		'@type': 'AboutPage',
		'@id': `${url}#page`,
		name: title,
		description,
		url,
		mainEntity: { '@id': `${url}#joe` },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		'@id': `${url}#joe`,
		name: 'Joe Hollenbach',
		jobTitle: 'Software Engineer',
		image: 'https://michiana.dev/assets/photo.webp',
		url,
		worksFor: { '@id': 'https://michiana.dev/#business' },
		sameAs: ['https://www.linkedin.com/in/joe-hollenbach', 'https://github.com/justjoe19'],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://michiana.dev/' },
			{ '@type': 'ListItem', position: 2, name: 'About', item: url },
		],
	},
]);
---

<Layout title={title} description={description}>
	<script type="application/ld+json" is:inline set:html={schema} />

	<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-paper">Skip to main content</a>

	<Navbar client:load />

	<main id="main-content">
		<About page />

		<div class="container-x pb-24 sm:pb-32">
			<div class="mx-auto max-w-[900px]">
				<BlogCTA />
			</div>
		</div>
	</main>

	<Footer />
</Layout>
