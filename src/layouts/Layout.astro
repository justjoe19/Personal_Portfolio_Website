---
import { areaServed } from '../data/areas';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../index.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import serifItalicLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import CommandPalette from '../components/CommandPalette';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	isHome?: boolean;
	noindex?: boolean;
}

const { 
	title, 
	description = "Michiana Dev is a local web and software studio in Mishawaka, Indiana. Fast, custom websites and software for South Bend and Michiana businesses.",
	image = "/og-image-v2.jpg",
	type = "website",
	isHome = false,
	noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

const websiteSchema = {
					"@context": "https://schema.org",
					"@type": "WebSite",
					"name": "Michiana Dev",
					"url": "https://michiana.dev"
				};

const businessSchema = {
					"@context": "https://schema.org",
					"@type": "ProfessionalService",
					"@id": "https://michiana.dev/#business",
					"name": "Michiana Dev LLC",
					"legalName": "Michiana Dev LLC",
					"alternateName": "Michiana.dev",
					"url": "https://michiana.dev",
					"logo": "https://michiana.dev/android-chrome-512x512.png",
					"image": "https://michiana.dev/og-image-v2.jpg",
					"telephone": "+15742138502",
					"founder": {
						"@type": "Person",
						"name": "Joe Hollenbach",
						"jobTitle": "Software Engineer",
						"sameAs": ["https://www.linkedin.com/in/joe-hollenbach", "https://github.com/justjoe19"]
					},
					"sameAs": ["https://www.linkedin.com/in/joe-hollenbach", "https://github.com/justjoe19", "https://share.google/Shycqyc3DYoD1z9DR"],
					"address": {
						"@type": "PostalAddress",
						"addressLocality": "Mishawaka",
						"addressRegion": "IN",
						"postalCode": "46544",
						"addressCountry": "US"
					},
					"geo": { "@type": "GeoCoordinates", "latitude": 41.6611, "longitude": -86.1706 },
					"areaServed": areaServed,
					"description": "Local web and software studio in Mishawaka, Indiana building fast, custom websites and software solutions for South Bend and Michiana businesses, with particular experience in contractors and restaurants. Also builds custom software and RankRadius, a local SEO platform for field-service businesses.",
					"slogan": "Websites and software solutions for Michiana businesses, built by a local engineer you work with directly.",
					"knowsAbout": ["Web design", "Local SEO", "Google Business Profile setup", "Contractor websites", "Restaurant websites", "Custom software"],
					"hasOfferCatalog": {
						"@type": "OfferCatalog",
						"name": "Services",
						"itemListElement": [
							{
								"@type": "Offer",
								"itemOffered": { "@type": "Service", "name": "Website", "description": "A custom, mobile-first website of typically 5–8 pages with local SEO and schema, contact form, click-to-call, 2 rounds of revisions, and Google Analytics and Search Console setup. Starting at $2,500." },
								"priceSpecification": { "@type": "PriceSpecification", "minPrice": "2500", "priceCurrency": "USD" }
							},
							{
								"@type": "Offer",
								"itemOffered": { "@type": "Service", "name": "Website + Local Launch", "description": "Everything in the Website package plus one-time Google Business Profile setup and handoff. Starting at $3,000." },
								"priceSpecification": { "@type": "PriceSpecification", "minPrice": "3000", "priceCurrency": "USD" }
							},
							{
								"@type": "Offer",
								"itemOffered": { "@type": "Service", "name": "Google Business Profile Setup", "description": "One-time setup and handoff with a walkthrough and guide. Not ongoing management." },
								"priceSpecification": { "@type": "PriceSpecification", "price": "450", "priceCurrency": "USD" }
							},
							{ "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom Websites & Software", "description": "CMS sites, restaurant menus and online ordering, booking, e-commerce, client portals, and SaaS. Quoted after a free consultation." } },
							{
								"@type": "Offer",
								"itemOffered": { "@type": "Service", "name": "Website Hosting & Maintenance" },
								"priceSpecification": { "@type": "UnitPriceSpecification", "price": "100", "priceCurrency": "USD", "unitText": "MONTH" }
							}
						]
					},
					"owns": {
						"@type": "SoftwareApplication",
						"name": "RankRadius",
						"url": "https://rankradius.io",
						"applicationCategory": "BusinessApplication",
						"operatingSystem": "Web"
					}
				};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Fonts: self-hosted; preload the two faces used above the fold -->
		<link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={serifItalicLatin} as="font" type="font/woff2" crossorigin />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="Web Design Mishawaka, Web Developer South Bend, Michiana Web Design, Local Web Developer Michiana, Website for Contractors, Restaurant Website Design, Google Business Profile Setup, Custom Website Design Indiana, Custom Software Development Indiana, Website Hosting and Maintenance" />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
		<meta name="theme-color" content="#0b0c12" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />
		{image === "/og-image-v2.jpg" && <meta property="og:image:width" content="1200" />}
		{image === "/og-image-v2.jpg" && <meta property="og:image:height" content="630" />}
		<meta property="og:site_name" content="Michiana Dev" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<!-- Structured Data (JSON-LD): Only on Homepage -->
		{isHome && (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
		)}
		{isHome && (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />
		)}

	</head>
	<body>
		<slot />
		<CommandPalette client:idle />
		<!-- Hidden form for Netlify field detection -->
		<form name="contact" data-netlify="true" netlify-honeypot="bot-field" hidden>
			<input type="hidden" name="form-name" value="contact" />
			<input type="text" name="bot-field" />
			<input type="text" name="name" />
			<input type="text" name="company" />
			<input type="text" name="service" />
			<input type="text" name="industry" />
			<input type="email" name="email" />
			<input type="tel" name="phone" />
			<textarea name="message"></textarea>
		</form>

		<script>
			import { hydrateEmailLinks } from '../lib/email';
			hydrateEmailLinks();
		</script>

		<script>
			import { initAnalytics } from '../lib/analytics';
			initAnalytics();
		</script>

		<script>
			// Cursor spotlight: any element with the `spotlight` class gets --mx/--my set on hover.
			document.addEventListener('pointermove', (e) => {
				const el = (e.target as Element | null)?.closest?.('.spotlight') as HTMLElement | null;
				if (!el) return;
				const r = el.getBoundingClientRect();
				el.style.setProperty('--mx', `${e.clientX - r.left}px`);
				el.style.setProperty('--my', `${e.clientY - r.top}px`);
			}, { passive: true });
		</script>

		<script>
			// Only fetch the identity widget bundle where it's actually needed:
			// the admin CMS, or a magic-link redirect carrying an invite/recovery token.
			const path = window.location.pathname;
			const hash = window.location.hash;
			const needsIdentity = path.startsWith('/admin') || hash.includes('invite_token') || hash.includes('recovery_token');

			if (needsIdentity) {
				import('netlify-identity-widget').then(({ default: netlifyIdentity }) => {
					netlifyIdentity.init();

					// Handle login and redirects
					netlifyIdentity.on('login', () => {
						document.location.href = "/admin/";
					});

					// If the URL has an invite or recovery token, force the widget to open
					if (hash.includes("invite_token") || hash.includes("recovery_token")) {
						netlifyIdentity.open();
					}

					// Make it available globally for the admin page if needed
					(window as any).netlifyIdentity = netlifyIdentity;
				});
			}
		</script>
	</body>
</html>
