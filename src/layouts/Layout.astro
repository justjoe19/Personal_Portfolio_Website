---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../index.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import serifItalicLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import CommandPalette from '../components/CommandPalette';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	isHome?: boolean;
	noindex?: boolean;
}

const { 
	title, 
	description = "Michiana Dev LLC is an independent design and engineering studio in Indiana building premium custom websites and software products for ambitious businesses.",
	image = "/og-image.jpg",
	type = "website",
	isHome = false,
	noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Fonts: self-hosted; preload the two faces used above the fold -->
		<link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={serifItalicLatin} as="font" type="font/woff2" crossorigin />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="Web Design Mishawaka, Web Developer South Bend, Custom Website Design Indiana, Premium Web Design, Custom Software Development Indiana, SaaS Development, Web Application Development Michiana, Website Hosting and Maintenance" />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
		<meta name="theme-color" content="#0b0c12" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />
		{image === "/og-image.jpg" && <meta property="og:image:width" content="1200" />}
		{image === "/og-image.jpg" && <meta property="og:image:height" content="630" />}
		<meta property="og:site_name" content="Michiana Dev" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<!-- Structured Data (JSON-LD): Only on Homepage -->
		{isHome && (
			<script type="application/ld+json" is:inline>
				{
					"@context": "https://schema.org",
					"@type": "WebSite",
					"name": "Michiana Dev",
					"url": "https://michiana.dev"
				}
			</script>
		)}
		{isHome && (
			<script type="application/ld+json" is:inline>
				{
					"@context": "https://schema.org",
					"@type": "ProfessionalService",
					"@id": "https://michiana.dev/#business",
					"name": "Michiana Dev LLC",
					"legalName": "Michiana Dev LLC",
					"alternateName": "Michiana.dev",
					"url": "https://michiana.dev",
					"logo": "https://michiana.dev/android-chrome-512x512.png",
					"image": "https://michiana.dev/og-image.jpg",
					"telephone": "+15742138502",
					"founder": {
						"@type": "Person",
						"name": "Joe Hollenbach",
						"jobTitle": "Software Engineer",
						"sameAs": ["https://www.linkedin.com/in/joe-hollenbach", "https://github.com/justjoe19"]
					},
					"sameAs": ["https://www.linkedin.com/in/joe-hollenbach", "https://github.com/justjoe19"],
					"address": {
						"@type": "PostalAddress",
						"addressLocality": "Mishawaka",
						"addressRegion": "IN",
						"postalCode": "46544",
						"addressCountry": "US"
					},
					"geo": { "@type": "GeoCoordinates", "latitude": 41.6611, "longitude": -86.1706 },
					"areaServed": ["South Bend, IN", "Mishawaka, IN", "Elkhart, IN", "Granger, IN", "Goshen, IN", "Niles, MI", "Edwardsburg, MI", "Dowagiac, MI", "United States"],
					"description": "Independent design and engineering studio building premium custom websites and software products, including RankRadius, a local SEO platform for field-service businesses.",
					"hasOfferCatalog": {
						"@type": "OfferCatalog",
						"name": "Services",
						"itemListElement": [
							{
								"@type": "Offer",
								"itemOffered": { "@type": "Service", "name": "Website Design & Development", "description": "Custom-designed websites: $500 for the first page (including a contact form), plus $100 for each additional page." },
								"priceSpecification": { "@type": "PriceSpecification", "minPrice": "500", "priceCurrency": "USD" }
							},
							{ "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom Software Development" } },
							{
								"@type": "Offer",
								"itemOffered": { "@type": "Service", "name": "Website Hosting & Maintenance" },
								"priceSpecification": { "@type": "UnitPriceSpecification", "price": "100", "priceCurrency": "USD", "unitText": "MONTH" }
							}
						]
					},
					"owns": {
						"@type": "SoftwareApplication",
						"name": "RankRadius",
						"url": "https://rankradius.io",
						"applicationCategory": "BusinessApplication",
						"operatingSystem": "Web"
					}
				}
			</script>
		)}

	</head>
	<body>
		<slot />
		<CommandPalette client:idle />
		<!-- Hidden form for Netlify field detection -->
		<form name="contact" data-netlify="true" netlify-honeypot="bot-field" hidden>
			<input type="hidden" name="form-name" value="contact" />
			<input type="text" name="bot-field" />
			<input type="text" name="name" />
			<input type="text" name="company" />
			<input type="text" name="service" />
			<input type="email" name="email" />
			<input type="tel" name="phone" />
			<textarea name="message"></textarea>
		</form>

		<script>
			import { hydrateEmailLinks } from '../lib/email';
			hydrateEmailLinks();
		</script>

		<script>
			// Cursor spotlight: any element with the `spotlight` class gets --mx/--my set on hover.
			document.addEventListener('pointermove', (e) => {
				const el = (e.target as Element | null)?.closest?.('.spotlight') as HTMLElement | null;
				if (!el) return;
				const r = el.getBoundingClientRect();
				el.style.setProperty('--mx', `${e.clientX - r.left}px`);
				el.style.setProperty('--my', `${e.clientY - r.top}px`);
			}, { passive: true });
		</script>

		<script>
			// Only fetch the identity widget bundle where it's actually needed:
			// the admin CMS, or a magic-link redirect carrying an invite/recovery token.
			const path = window.location.pathname;
			const hash = window.location.hash;
			const needsIdentity = path.startsWith('/admin') || hash.includes('invite_token') || hash.includes('recovery_token');

			if (needsIdentity) {
				import('netlify-identity-widget').then(({ default: netlifyIdentity }) => {
					netlifyIdentity.init();

					// Handle login and redirects
					netlifyIdentity.on('login', () => {
						document.location.href = "/admin/";
					});

					// If the URL has an invite or recovery token, force the widget to open
					if (hash.includes("invite_token") || hash.includes("recovery_token")) {
						netlifyIdentity.open();
					}

					// Make it available globally for the admin page if needed
					(window as any).netlifyIdentity = netlifyIdentity;
				});
			}
		</script>
	</body>
</html>
