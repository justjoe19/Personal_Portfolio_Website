---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact';
import CaseStudies from '../components/CaseStudies.astro';
import Pricing from '../components/Pricing.astro';
import { cityPages } from '../data/areas';
import type { Industry } from '../data/industries';

interface Props {
	industry: Industry;
}

const { industry } = Astro.props;
const url = `https://michiana.dev/${industry.slug}`;

const schema = JSON.stringify([
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${url}#page`,
		name: industry.title,
		description: industry.description,
		url,
		about: { '@id': 'https://michiana.dev/#business' },
		mainEntity: { '@id': `${url}#service` },
		speakable: {
			'@type': 'SpeakableSpecification',
			cssSelector: ['#quick-answer', '#faq'],
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		'@id': `${url}#service`,
		name: industry.serviceType,
		serviceType: industry.serviceType,
		description: industry.quickAnswer,
		url,
		provider: { '@id': 'https://michiana.dev/#business' },
		areaServed: cityPages.map((c) => `${c.name}, ${c.state}`).concat(['Michiana', 'Northern Indiana', 'Southwest Michigan']),
		hasOfferCatalog: {
			'@type': 'OfferCatalog',
			name: `${industry.name} Packages`,
			itemListElement: [
				{
					'@type': 'Offer',
					itemOffered: { '@type': 'Service', name: 'Simple Starter Site', description: '1–3 page custom, mobile-first website for solo or newer local businesses. Quoted around your scope.' },
				},
				{
					'@type': 'Offer',
					itemOffered: { '@type': 'Service', name: 'Business Website + Local Launch', description: '5–8+ page custom website with local SEO, schema markup, and one-time Google Business Profile setup and handoff. Quoted around your scope.' },
				},
			],
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://michiana.dev/' },
			{ '@type': 'ListItem', position: 2, name: industry.name, item: url },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: industry.faqs.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a },
		})),
	},
]);

const check = '<svg class="mt-[3px] h-4 w-4 shrink-0 text-leaf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
---

<Layout title={industry.title} description={industry.description}>
	<script type="application/ld+json" is:inline set:html={schema} />

	<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-paper">Skip to main content</a>

	<Navbar client:load />

	<main id="main-content">
		<section class="relative overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-28">
			<div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(70%_60%_at_50%_30%,#000,transparent)]"></div>
			<div class="container-x relative max-w-4xl">
				<nav aria-label="Breadcrumb" class="text-[0.72rem] uppercase tracking-[0.16em] text-muted">
					<a href="/" class="hover:text-ink">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">{industry.name}</span>
				</nav>
				<p class="eyebrow mt-8">{industry.eyebrow}</p>
				<h1 class="display mt-5 text-[clamp(2.4rem,6vw,5rem)]">
					<span class="text-fade">{industry.h1[0]}</span> <span class="serif-accent text-gradient pr-2">{industry.h1[1]}</span>
				</h1>
				<p class="mt-7 max-w-2xl text-[clamp(1.05rem,1.6vw,1.2rem)] leading-relaxed text-body">{industry.intro}</p>
				<div class="mt-10 flex flex-col gap-3 sm:flex-row">
					<a href="#contact" class="btn-primary">
						{industry.ctaLabel}
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
					</a>
					<a href="#pricing" class="btn-ghost">See packages &amp; pricing</a>
				</div>
				<p class="mt-4 text-sm text-muted">
					Based in Mishawaka, IN · Call Joe directly at <a href="tel:+15742138502" class="font-semibold text-ink underline-offset-4 hover:underline">(574) 213-8502</a>
				</p>

				<aside id="quick-answer" aria-label={`Quick summary of ${industry.name.toLowerCase()} web design`} class="card mt-10 p-6">
					<span class="text-[0.68rem] uppercase tracking-[0.15em] text-leaf">At a Glance · {industry.name}</span>
					<p class="mt-2.5 text-[0.98rem] leading-relaxed text-ink">{industry.quickAnswer}</p>
				</aside>
			</div>
		</section>

		<section class="border-t border-line py-24 sm:py-32" aria-labelledby="what-you-get">
			<div class="container-x">
				<div class="reveal max-w-3xl">
					<p class="eyebrow">What you get</p>
					<h2 id="what-you-get" class="display mt-5 text-[clamp(2.2rem,4.8vw,3.8rem)]">Built for <span class="serif-accent text-gradient">how your customers decide.</span></h2>
				</div>
				<ul class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{industry.features.map((f) => (
						<li class="spotlight card reveal flex gap-3 p-6">
							<Fragment set:html={check} />
							<div>
								<h3 class="font-semibold text-ink">{f.title}</h3>
								<p class="mt-2 text-[0.92rem] leading-relaxed text-muted">{f.desc}</p>
							</div>
						</li>
					))}
				</ul>

				{industry.slug === 'restaurants' && (
					<div class="reveal card mt-10 grid gap-8 p-7 sm:p-9 lg:grid-cols-[1fr_1.15fr] lg:items-center">
						<div>
							<p class="eyebrow">Why guests leave PDF menus</p>
							<h3 class="mt-3 text-2xl font-semibold tracking-tight text-ink">
								Built for hungry guests on a phone—not a desktop printer.
							</h3>
							<p class="mt-3 text-[0.95rem] leading-relaxed text-body">
								When someone searches for dinner in Mishawaka, South Bend, or St. Joseph, they want three things in five seconds: today’s hours, a readable menu, and a way to order or book a table. Every restaurant site I build puts those right at the top.
							</p>
						</div>
						<div class="rounded-2xl border border-line bg-paper p-5" aria-hidden="true">
							<div class="flex flex-wrap items-center justify-between gap-2 border-b border-line pb-3">
								<span class="flex items-center gap-2 text-xs text-leaf">
									<span class="h-2 w-2 rounded-full bg-leaf"></span>Open today · 11:00 AM – 9:30 PM
								</span>
								<span class="text-xs text-muted">Mishawaka · Tap for directions ↗</span>
							</div>
							<div class="mt-4 space-y-3">
								<div class="flex items-baseline justify-between gap-4 border-b border-line/60 pb-2.5">
									<div>
										<p class="font-semibold text-ink">Wood-Fired Margherita</p>
										<p class="text-xs text-muted">San Marzano tomato, fresh mozzarella, basil, sea salt</p>
									</div>
									<span class="text-sm font-medium text-ink">$16</span>
								</div>
								<div class="flex items-baseline justify-between gap-4 border-b border-line/60 pb-2.5">
									<div>
										<p class="font-semibold text-ink">Lake Perch Platter <span class="ml-1.5 rounded bg-leaf/15 px-1.5 py-0.5 text-[0.62rem] text-leaf">GF option</span></p>
										<p class="text-xs text-muted">Hand-breaded Great Lakes perch, house slaw, lemon</p>
									</div>
									<span class="text-sm font-medium text-ink">$24</span>
								</div>
							</div>
							<div class="mt-4 flex gap-2 pt-1">
								<span class="rounded-full bg-ink px-3.5 py-1.5 text-xs font-medium text-paper">Order Online</span>
								<span class="rounded-full border border-line-strong px-3.5 py-1.5 text-xs font-medium text-ink">Call (574) 213-8502</span>
							</div>
						</div>
					</div>
				)}

				{industry.note && <p class="reveal mt-8 max-w-3xl text-body">{industry.note}</p>}
				<p class="reveal mt-4 max-w-3xl text-body">
					Customer reviews are one of the strongest signals for local Google rankings. Try my free <a href="/review-responder" class="link-arrow">AI Review Responder</a> to draft replies to your customer reviews in seconds.
				</p>
			</div>
		</section>

		<CaseStudies
			slugs={industry.projectSlugs}
			id="portfolio"
			showSoftwareStrip={false}
			eyebrow="Michiana Proof of Work"
			heading={['Real projects I’ve', 'built from scratch.']}
		/>

		{industry.addon && (
			<section class="border-t border-line py-16 sm:py-20" aria-label={industry.addon.title}>
				<div class="container-x">
					<div class="spotlight card reveal flex flex-col gap-4 p-8 sm:flex-row sm:items-center sm:justify-between">
						<div class="max-w-2xl">
							<h2 class="text-xl font-semibold tracking-tight">{industry.addon.title}</h2>
							<p class="mt-2 text-body">{industry.addon.desc}</p>
						</div>
						<a href={industry.addon.href} target="_blank" rel="noopener" class="btn-ghost shrink-0">{industry.addon.linkLabel} <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>
		)}

		<Pricing compact />

		<section class="border-t border-line py-16 sm:py-20" aria-labelledby="industry-areas-heading">
			<div class="container-x">
				<h2 id="industry-areas-heading" class="eyebrow">Serving {industry.name.toLowerCase()} across Michiana</h2>
				<ul class="mt-5 flex flex-wrap gap-2.5">
					{cityPages.map((c) => (
						<li>
							<a href={`/service-areas/${c.slug}`} class="inline-block rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium text-ink hover:border-accent hover:text-sky">
								{c.name}, {c.state} →
							</a>
						</li>
					))}
					<li>
						<a href="/service-areas" class="inline-block rounded-full border border-line-strong px-4 py-2 text-sm font-medium text-muted hover:text-ink">
							All 20 Michiana towns →
						</a>
					</li>
				</ul>
			</div>
		</section>

		<Faq faqs={industry.faqs} title={`${industry.name}: common questions`} id="faq" />
		<Contact client:visible defaultIndustry={industry.contactIndustry} heading={industry.contactHeading} />
	</main>

	<Footer />
</Layout>
