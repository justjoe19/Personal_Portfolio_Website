---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact';
import CaseStudies from '../components/CaseStudies.astro';
import type { Industry } from '../data/industries';

interface Props {
	industry: Industry;
}

const { industry } = Astro.props;
const url = `https://michiana.dev/${industry.slug}`;

const schema = JSON.stringify([
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		'@id': `${url}#service`,
		name: industry.serviceType,
		serviceType: industry.serviceType,
		description: industry.description,
		url,
		provider: { '@id': 'https://michiana.dev/#business' },
		areaServed: ['Mishawaka, IN', 'South Bend, IN', 'Michiana'],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://michiana.dev/' },
			{ '@type': 'ListItem', position: 2, name: industry.name, item: url },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: industry.faqs.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a },
		})),
	},
]);

const check = '<svg class="mt-[3px] h-4 w-4 shrink-0 text-leaf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
---

<Layout title={industry.title} description={industry.description}>
	<script type="application/ld+json" is:inline set:html={schema} />

	<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-paper">Skip to main content</a>

	<Navbar client:load />

	<main id="main-content">
		<section class="relative overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-28">
			<div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(70%_60%_at_50%_30%,#000,transparent)]"></div>
			<div class="container-x relative max-w-4xl">
				<nav aria-label="Breadcrumb" class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-muted">
					<a href="/" class="hover:text-ink">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">{industry.name}</span>
				</nav>
				<p class="eyebrow mt-8">{industry.eyebrow}</p>
				<h1 class="display mt-5 text-[clamp(2.4rem,6vw,5rem)]">
					<span class="text-fade">{industry.h1[0]}</span> <span class="serif-accent text-gradient pr-2">{industry.h1[1]}</span>
				</h1>
				<p class="mt-7 max-w-2xl text-[clamp(1.05rem,1.6vw,1.2rem)] leading-relaxed text-body">{industry.intro}</p>
				<div class="mt-10 flex flex-col gap-3 sm:flex-row">
					<a href="#contact" class="btn-primary">
						{industry.ctaLabel}
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
					</a>
					<a href="/services#pricing" class="btn-ghost">See pricing</a>
				</div>
			</div>
		</section>

		<section class="border-t border-line py-24 sm:py-32" aria-labelledby="what-you-get">
			<div class="container-x">
				<div class="reveal max-w-3xl">
					<p class="eyebrow">What you get</p>
					<h2 id="what-you-get" class="display mt-5 text-[clamp(2.2rem,4.8vw,3.8rem)]">Built for <span class="serif-accent text-gradient">how you work.</span></h2>
				</div>
				<ul class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
					{industry.features.map((f) => (
						<li class="spotlight card reveal flex gap-3 p-6">
							<Fragment set:html={check} />
							<div>
								<h3 class="font-semibold">{f.title}</h3>
								<p class="mt-2 text-[0.92rem] leading-relaxed text-muted">{f.desc}</p>
							</div>
						</li>
					))}
				</ul>
				{industry.note && <p class="reveal mt-8 max-w-3xl text-body">{industry.note}</p>}
				<p class="reveal mt-4 max-w-3xl text-body">
					Reviews matter for local search. Try my free <a href="/review-responder" class="link-arrow">AI Review Responder</a> to draft replies to your customer reviews.
				</p>
			</div>
		</section>

		<CaseStudies slugs={industry.projectSlugs} id="portfolio" />

		{/* Hidden until a real restaurant (or other) case study exists. */}
		{industry.caseStudies.length > 0 && (
			<section class="border-t border-line py-24 sm:py-32" aria-labelledby="case-study-heading">
				<div class="container-x">
					<h2 id="case-study-heading" class="display text-[clamp(2.2rem,4.8vw,3.8rem)]">Case <span class="serif-accent text-gradient">study.</span></h2>
					<div class="mt-12 grid gap-4 lg:grid-cols-2">
						{industry.caseStudies.map((c) => (
							<article class="spotlight card reveal p-7">
								<h3 class="text-xl font-semibold">{c.name}</h3>
								<p class="mt-3 text-body">{c.summary}</p>
								{c.result && <p class="mt-4 font-medium text-ink">{c.result}</p>}
								{c.href && <a href={c.href} class="link-arrow mt-4 inline-block">View project <span aria-hidden="true">→</span></a>}
							</article>
						))}
					</div>
				</div>
			</section>
		)}

		{industry.addon && (
			<section class="border-t border-line py-16 sm:py-20" aria-label={industry.addon.title}>
				<div class="container-x">
					<div class="spotlight card reveal flex flex-col gap-4 p-8 sm:flex-row sm:items-center sm:justify-between">
						<div class="max-w-2xl">
							<h2 class="text-xl font-semibold tracking-tight">{industry.addon.title}</h2>
							<p class="mt-2 text-body">{industry.addon.desc}</p>
						</div>
						<a href={industry.addon.href} target="_blank" rel="noopener" class="btn-ghost shrink-0">{industry.addon.linkLabel} <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>
		)}

		<Faq faqs={industry.faqs} title={`${industry.name}: common questions`} id="faq" />
		<Contact client:visible defaultIndustry={industry.contactIndustry} heading={industry.contactHeading} />
	</main>

	<Footer />
</Layout>
