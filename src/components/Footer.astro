---
import Logo from './Logo';

const year = new Date().getFullYear();

const columns = [
	{
		title: 'Services',
		links: [
			{ label: 'Website design', href: '/#services' },
			{ label: 'Custom software', href: '/#services' },
			{ label: 'Hosting & maintenance', href: '/#hosting' },
			{ label: 'Pricing', href: '/#pricing' },
		],
	},
	{
		title: 'Studio',
		links: [
			{ label: 'Work', href: '/work' },
			{ label: 'About', href: '/#about' },
			{ label: 'Blog', href: '/blog' },
			{ label: 'FAQ', href: '/#faq' },
		],
	},
	{
		title: 'Products',
		links: [
			{ label: 'RankRadius ↗', href: 'https://rankradius.io', external: true },
			{ label: 'AI Review Responder', href: '/review-responder' },
		],
	},
];
---

<footer class="relative overflow-hidden border-t border-line bg-night">
	<div class="container-x pt-20 pb-10">
		<div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
			<div>
				<a href="/" class="inline-flex items-center gap-2.5 text-ink" aria-label="Michiana Dev — home">
					<Logo className="h-9 w-9" />
					<span class="text-lg font-semibold tracking-tight">Michiana<span class="text-muted">.dev</span></span>
				</a>
				<p class="mt-5 max-w-xs leading-relaxed text-muted">
					An independent design &amp; engineering studio in Mishawaka, Indiana.
				</p>
				<p class="mt-6 space-y-1">
					<a data-email href="/#contact" class="block font-medium text-ink hover:text-sky">Email me</a>
					<a href="tel:+15742138502" class="block text-muted hover:text-ink">(574) 213-8502</a>
				</p>
			</div>

			{columns.map((col) => (
				<nav aria-label={col.title}>
					<p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-muted">{col.title}</p>
					<ul class="mt-4 space-y-2.5">
						{col.links.map((l) => (
							<li>
								<a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})} class="text-body hover:text-ink">{l.label}</a>
							</li>
						))}
					</ul>
				</nav>
			))}
		</div>

		<p aria-hidden="true" class="pointer-events-none mt-20 select-none text-center text-[clamp(3.5rem,15vw,13rem)] leading-[0.85] font-semibold tracking-[-0.06em] text-transparent" style="background-image:linear-gradient(180deg,oklch(1 0 0 / 0.16),oklch(1 0 0 / 0.01));-webkit-background-clip:text;background-clip:text;">
			michiana.dev
		</p>

		<div class="mt-10 flex flex-col gap-3 border-t border-line pt-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
			<p>© {year} Michiana Dev LLC. An Indiana limited liability company.</p>
			<div class="flex gap-5">
				<a href="https://www.linkedin.com/in/joe-hollenbach" target="_blank" rel="noopener noreferrer" class="hover:text-ink">LinkedIn</a>
				<a href="https://github.com/justjoe19" target="_blank" rel="noopener noreferrer" class="hover:text-ink">GitHub</a>
			</div>
		</div>
	</div>
</footer>
