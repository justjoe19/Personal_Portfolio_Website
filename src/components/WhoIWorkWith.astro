---
const industries = [
	{ href: '/contractors', title: 'Contractors & home services', desc: 'Roofing, restoration, HVAC, plumbing, and other trades.' },
	{ href: '/restaurants', title: 'Restaurants', desc: 'Menus, hours, ordering, and photo-forward design.' },
];
---

<section id="who-i-work-with" class="relative border-b border-line py-16 sm:py-20" aria-labelledby="who-heading">
	<div class="container-x">
		<div class="reveal flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
			<div class="max-w-sm">
				<p class="eyebrow">Who I work with</p>
				<h2 id="who-heading" class="display mt-4 text-[clamp(1.6rem,3vw,2.2rem)]">Local businesses <span class="serif-accent text-gradient">like yours.</span></h2>
			</div>
			<ul class="grid flex-1 gap-4 sm:grid-cols-2 lg:max-w-3xl">
				{industries.map((i) => (
					<li>
						<a href={i.href} class="spotlight card group flex h-full items-start justify-between gap-4 p-6">
							<span>
								<span class="block font-semibold tracking-tight text-ink">{i.title}</span>
								<span class="mt-1.5 block text-[0.92rem] leading-relaxed text-muted">{i.desc}</span>
							</span>
							<span class="text-muted transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ul>
		</div>
		<p class="reveal mt-6 text-body">…and other local businesses: <a href="#contact" class="link-arrow">let’s talk <span aria-hidden="true">→</span></a></p>
	</div>
</section>
