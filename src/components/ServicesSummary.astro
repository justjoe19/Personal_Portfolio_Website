---
const items = [
	{
		num: '01',
		title: 'Simple starter & business sites',
		price: 'Starting at $500',
		desc: 'From 1–3 page starter sites for new local shops to full 5–8+ page websites with local SEO, lead forms, and tap-to-call.',
		href: '/services#website',
	},
	{
		num: '02',
		title: 'Google Business Profile setup',
		price: '$350 one-time',
		desc: 'One-time setup, optimization, and handoff with a walkthrough—no ongoing monthly retainer.',
		href: '/services#google-business-profile',
	},
	{
		num: '03',
		title: 'Custom websites & software',
		price: 'Scoped to fit',
		desc: 'Easy-to-update content editors, restaurant menus & ordering, booking systems, client portals, and custom web applications.',
		href: '/services#software',
	},
	{
		num: '04',
		title: 'Hosting & monthly care',
		price: '$100/month',
		desc: 'Fast, secure hosting with SSL, regular backups, and up to one hour per month of content updates handled directly by me.',
		href: '/services#hosting-maintenance',
	},
];
---

<section id="services" class="relative border-t border-line py-24 sm:py-32" aria-labelledby="services-heading">
	<div class="container-x">
		<div class="reveal flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
			<div class="max-w-3xl">
				<p class="eyebrow">Services</p>
				<h2 id="services-heading" class="display mt-5 text-[clamp(2.4rem,5.4vw,4.4rem)]">
					Websites, software, and <span class="serif-accent text-gradient">local search setup.</span>
				</h2>
				<p class="mt-5 max-w-2xl text-lg leading-relaxed text-body">
					Everything your business needs to look sharp online, show up in local searches, and turn visitors into customers—designed and built by one person in Mishawaka.
				</p>
			</div>
			<a href="/services" class="btn-ghost self-start sm:self-auto">All services &amp; details <span aria-hidden="true">→</span></a>
		</div>

		<ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{items.map((i) => (
				<li>
					<a href={i.href} class="spotlight card reveal group flex h-full flex-col p-6">
						<div class="flex items-center justify-between gap-2">
							<span class="text-xs text-muted">{i.num}</span>
							<span class="rounded-full border border-line bg-sand px-2.5 py-0.5 text-[0.68rem] font-medium text-accent">{i.price}</span>
						</div>
						<h3 class="mt-4 text-lg font-semibold tracking-tight text-ink group-hover:text-sky">{i.title}</h3>
						<p class="mt-2.5 text-[0.92rem] leading-relaxed text-muted">{i.desc}</p>
						<span class="mt-auto pt-5 text-sm font-medium text-ink transition-transform group-hover:translate-x-0.5">
							Learn more <span aria-hidden="true">→</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</div>
</section>
