---
const check = '<svg class="mt-[3px] h-4 w-4 shrink-0 text-leaf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

interface Props {
	/** Homepage teaser: shorter feature lists, no add-ons row, link to the full /services page. */
	compact?: boolean;
}

const { compact = false } = Astro.props;

const plans = [
	{
		id: 'website',
		name: 'Website',
		tagline: 'A custom site built to bring in calls and customers.',
		prefix: 'Starting at',
		price: '$2,500',
		unit: '',
		features: [
			'Custom design, typically 5–8 pages',
			'Mobile-first and fast',
			'Local SEO and schema built in',
			'Contact form and click-to-call',
			'2 rounds of revisions',
			'Google Analytics + Search Console setup',
		],
		note: 'Plus $100/mo hosting: SSL, backups, and 1 hour per month of minor updates.',
		cta: 'Get a free website review',
		featured: false,
	},
	{
		id: 'local-launch',
		name: 'Website + Local Launch',
		tagline: 'Your new site and a Google profile that matches it.',
		prefix: 'Starting at',
		price: '$3,000',
		unit: '',
		features: [
			'Everything in Website',
			'Google Business Profile setup and handoff',
			'Categories, services, areas, hours, photos',
			'Name, address and phone consistent with your site',
			'Review-request link, plus a walkthrough and guide',
		],
		note: 'Plus $100/mo hosting. The Google profile is set up and handed to you to run. It isn’t managed monthly.',
		cta: 'Get a free website review',
		featured: true,
	},
	{
		id: 'custom',
		name: 'Custom websites & software',
		tagline: 'Bigger builds, scoped around how your business works.',
		prefix: '',
		price: 'Quoted',
		unit: 'after a free consultation',
		features: [
			'CMS-driven sites',
			'Restaurant menus and online ordering',
			'Booking and e-commerce',
			'Client portals and SaaS products',
		],
		note: 'Most custom projects range from $5,000–$15,000.',
		cta: 'Book a free consultation',
		featured: false,
	},
];

const addons = [
	{ name: 'Additional pages', price: 'from $200 each' },
	{ name: 'Location pages', price: 'from $150 each' },
	{ name: 'Google Business Profile setup only', price: '$450 one-time' },
	{ name: 'RankRadius (field-service businesses)', price: '$399/mo', href: 'https://rankradius.io' },
];
---

<section id="pricing" class="theme-light relative overflow-hidden border-t border-line py-24 sm:py-32">
	<div aria-hidden="true" class="pointer-events-none absolute top-1/3 left-1/2 h-[520px] w-[820px] -translate-x-1/2 rounded-full bg-accent/10 blur-[140px]"></div>

	<div class="container-x relative">
		<div class="reveal mx-auto max-w-2xl text-center">
			<p class="eyebrow">Pricing</p>
			<h2 class="display mt-5 text-[clamp(2.4rem,5.4vw,4.4rem)]">
				Clear packages, <span class="serif-accent text-gradient">upfront</span> pricing.
			</h2>
			<p class="mt-6 text-lg leading-relaxed text-body">
				Every project begins with a free consultation and a clear quote before any work starts.
			</p>
		</div>

		<div class="mt-16 grid gap-5 lg:grid-cols-3 lg:items-stretch">
			{plans.map((p) => (
				<article id={p.id === 'local-launch' ? 'local-launch' : undefined} class:list={['reveal flex scroll-mt-28 rounded-3xl', p.featured && 'glow-border lg:-my-3']}>
					<div class:list={['spotlight flex w-full flex-col rounded-3xl p-8', p.featured ? 'bg-surface/95 lg:py-11' : 'card']}>
						<div class="flex items-center justify-between gap-3">
							<h3 class="text-lg font-semibold tracking-tight">{p.name}</h3>
							{p.featured && <span class="rounded-full bg-leaf/15 px-2.5 py-1 font-mono text-[0.65rem] font-medium text-leaf">Most popular</span>}
						</div>
						<p class="mt-2 text-sm leading-relaxed text-muted">{p.tagline}</p>

						<p class="mt-8 flex flex-wrap items-baseline gap-x-2">
							{p.prefix && <span class="text-muted">{p.prefix}</span>}
							<span class="display text-6xl"><span class:list={[p.featured && 'text-gradient']}>{p.price}</span></span>
							{p.unit && <span class="text-muted">{p.unit}</span>}
						</p>

						<ul class="mt-8 space-y-3 border-t border-line pt-8">
							{(compact ? p.features.slice(0, 3) : p.features).map((f) => (
								<li class="flex gap-3 text-[0.95rem] text-ink"><Fragment set:html={check} />{f}</li>
							))}
						</ul>

						<p class="mt-6 text-sm leading-relaxed text-muted">{p.note}</p>

						<div class="mt-auto pt-8">
							<a href="#contact" class:list={['w-full', p.featured ? 'btn-primary' : 'btn-ghost']}>{p.cta}</a>
						</div>
					</div>
				</article>
			))}
		</div>

		{compact ? (
			<p class="reveal mt-12 text-center text-body">
				Add-ons, hosting details, and what’s included in each package: <a href="/services#pricing" class="link-arrow">See full pricing <span aria-hidden="true">→</span></a>
			</p>
		) : (
		<!-- Add-ons -->
		<div id="hosting" class="reveal mt-14 scroll-mt-28">
			<h3 class="eyebrow justify-center text-center">Add-ons</h3>
			<ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
				{addons.map((a) => (
					<li class="card flex flex-col rounded-2xl p-5">
						<span class="text-sm text-body">
							{a.href ? <a href={a.href} target="_blank" rel="noopener" class="link-arrow text-ink underline-offset-4 hover:underline">{a.name}</a> : a.name}
						</span>
						<span class="mt-2 font-mono text-[0.8rem] text-ink">{a.price}</span>
					</li>
				))}
			</ul>
			<p class="mt-6 text-center text-sm text-muted">All prices are starting prices. Hosting &amp; maintenance is $100/mo with any website.</p>
		</div>
		)}
	</div>
</section>
