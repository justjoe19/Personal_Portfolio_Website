---
const check = '<svg class="mt-[3px] h-4 w-4 shrink-0 text-leaf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

interface Props {
	/** Homepage teaser: shorter feature lists, no add-ons row, link to the full /services page. */
	compact?: boolean;
}

const { compact = false } = Astro.props;

const plans = [
	{
		id: 'starter',
		name: 'Simple Starter Site',
		tagline: 'A fast, credible website for solo or newer local businesses.',
		label: 'Starter',
		sublabel: 'Starting at $500',
		features: [
			'Custom 1–3 page mobile-first design',
			'Tap-to-call button & lead contact form',
			'Local Google & AI search foundation',
			'Google Analytics & Search Console setup',
			'Fast 1–2 week turnaround',
		],
		note: 'Ideal if you’re just getting established or replacing a single-page template without overbuilding.',
		cta: 'Get a free quote',
		featured: false,
	},
	{
		id: 'local-launch',
		name: 'Business Website + Local Launch',
		tagline: 'A full custom site and a Google Business Profile that matches it.',
		label: 'Full Site',
		sublabel: 'Quoted around your scope',
		features: [
			'Custom 5–8+ page mobile-first website',
			'Dedicated service & Michiana town pages',
			'One-time Google Business Profile setup & handoff',
			'Categories, services, areas, hours & photos aligned',
			'Review-request link & walkthrough',
		],
		note: 'The Google profile is set up and handed to you to run—never a monthly SEO retainer. Optional hosting & care available.',
		cta: 'Get a free website review',
		featured: true,
	},
	{
		id: 'custom',
		name: 'Custom Websites & Software',
		tagline: 'Bigger builds, scoped around how your business operates.',
		label: 'Custom',
		sublabel: 'Quoted after a free consultation',
		features: [
			'Easy-to-update content & menu editor',
			'Restaurant menus & online ordering',
			'Appointment booking & e-commerce',
			'Client portals & custom web software',
		],
		note: 'Built from scratch with clear project milestones and a fixed quote before work begins.',
		cta: 'Book a free consultation',
		featured: false,
	},
];

const addons = [
	{ name: 'Additional service or location pages', detail: 'Expand your local reach anytime' },
	{ name: 'Google Business Profile setup only', detail: 'One-time setup & owner handoff' },
	{ name: 'Website hosting & maintenance', detail: 'SSL, backups & 1 hr/mo of updates' },
	{ name: 'RankRadius (field-service businesses)', detail: 'Automated neighborhood proof add-on', href: 'https://rankradius.io' },
];
---

<section id="pricing" class="theme-light relative overflow-hidden border-t border-line py-24 sm:py-32">
	<div aria-hidden="true" class="pointer-events-none absolute top-1/3 left-1/2 h-[520px] w-[820px] -translate-x-1/2 rounded-full" style="background: radial-gradient(50% 50% at 50% 50%, oklch(0.49 0.19 258 / 0.08), transparent 70%);"></div>

	<div class="container-x relative">
		<div class="reveal mx-auto max-w-2xl text-center">
			<p class="eyebrow">Packages &amp; Scope</p>
			<h2 class="display mt-5 text-[clamp(2.4rem,5.4vw,4.4rem)]">
				Clear packages, <span class="serif-accent text-gradient">tailored</span> to your budget.
			</h2>
			<p class="mt-6 text-lg leading-relaxed text-body">
				From simple starter sites for new local shops to full custom builds, every project begins with a free consultation and a clear, fixed quote before any work starts.
			</p>
		</div>

		<div class="mt-16 grid gap-5 lg:grid-cols-3 lg:items-stretch">
			{plans.map((p) => (
				<article id={p.id === 'local-launch' ? 'local-launch' : p.id === 'starter' ? 'website' : undefined} class:list={['reveal flex scroll-mt-28 rounded-3xl', p.featured && 'glow-border lg:-my-3']}>
					<div class:list={['spotlight flex w-full flex-col rounded-3xl p-8', p.featured ? 'bg-surface lg:py-11 shadow-lg' : 'card']}>
						<div class="flex items-center justify-between gap-3">
							<h3 class="text-lg font-semibold tracking-tight text-ink">{p.name}</h3>
							{p.featured && <span class="rounded-full bg-leaf/15 px-2.5 py-1 text-[0.7rem] font-semibold text-leaf">Most popular</span>}
						</div>
						<p class="mt-2 text-sm leading-relaxed text-muted">{p.tagline}</p>

						<div class="mt-8">
							<p class="display text-4xl sm:text-5xl"><span class:list={[p.featured && 'text-gradient']}>{p.label}</span></p>
							<p class="mt-1.5 text-sm font-medium text-muted">{p.sublabel}</p>
						</div>

						<ul class="mt-8 space-y-3 border-t border-line pt-8">
							{(compact ? p.features.slice(0, 3) : p.features).map((f) => (
								<li class="flex gap-3 text-[0.95rem] text-ink"><Fragment set:html={check} />{f}</li>
							))}
						</ul>

						<p class="mt-6 text-sm leading-relaxed text-muted">{p.note}</p>

						<div class="mt-auto pt-8">
							<a href="#contact" class:list={['w-full', p.featured ? 'btn-primary' : 'btn-ghost']}>{p.cta}</a>
						</div>
					</div>
				</article>
			))}
		</div>

		{compact ? (
			<p class="reveal mt-12 text-center text-body">
				Want to see add-ons and what’s included? <a href="/services#pricing" class="link-arrow">See full service details <span aria-hidden="true">→</span></a> · Have questions? <a href="/faq" class="link-arrow">Read the FAQ <span aria-hidden="true">→</span></a>
			</p>
		) : (
		<!-- Add-ons -->
		<div id="hosting" class="reveal mt-14 scroll-mt-28">
			<h3 class="eyebrow justify-center text-center">Optional Add-ons &amp; Care</h3>
			<ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
				{addons.map((a) => (
					<li class="card flex flex-col rounded-2xl p-5">
						<span class="text-sm font-semibold text-ink">
							{a.href ? <a href={a.href} target="_blank" rel="noopener" class="link-arrow text-ink underline-offset-4 hover:underline">{a.name}</a> : a.name}
						</span>
						<span class="mt-2 text-xs text-muted">{a.detail}</span>
					</li>
				))}
			</ul>
			<p class="mt-6 text-center text-sm text-muted">Every project receives a clear, fixed quote after a free consultation.</p>
		</div>
		)}
	</div>
</section>
