---
// Soft, sunlit architectural gradient wash for the hero background.
interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['pointer-events-none absolute inset-0 overflow-hidden', className]} aria-hidden="true">
	<div
		class="absolute inset-0"
		style="background:
			radial-gradient(60% 50% at 18% 12%, oklch(0.86 0.08 245 / 0.28), transparent 70%),
			radial-gradient(50% 45% at 85% 18%, oklch(0.88 0.07 165 / 0.22), transparent 70%),
			radial-gradient(45% 40% at 50% 78%, oklch(0.92 0.05 85 / 0.35), transparent 70%);"
	></div>
</div>
