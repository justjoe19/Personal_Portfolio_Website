---
// A hand-written WebGL fragment shader: a slow, flowing aurora in the brand colors.
// Renders at reduced resolution, pauses offscreen, and draws a single frame for reduced-motion users.
interface Props {
	class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['pointer-events-none absolute inset-0 overflow-hidden', className]} aria-hidden="true">
	<!-- Static fallback when WebGL is unavailable -->
	<div class="absolute inset-0 [background:radial-gradient(60%_50%_at_20%_20%,oklch(0.55_0.16_270/0.45),transparent_70%),radial-gradient(50%_45%_at_85%_30%,oklch(0.6_0.12_220/0.35),transparent_70%),radial-gradient(45%_40%_at_60%_90%,oklch(0.6_0.13_152/0.25),transparent_70%)]"></div>
	<canvas data-aurora class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-[1200ms]"></canvas>
</div>

<script>
	const VERT = `attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }`;
	const FRAG = `
		precision mediump float;
		uniform vec2 r;
		uniform float t;
		uniform vec2 m;

		float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
		float noise(vec2 p){
			vec2 i = floor(p), f = fract(p);
			vec2 u = f * f * (3.0 - 2.0 * f);
			return mix(mix(hash(i), hash(i + vec2(1,0)), u.x), mix(hash(i + vec2(0,1)), hash(i + vec2(1,1)), u.x), u.y);
		}
		float fbm(vec2 p){
			float v = 0.0, a = 0.5;
			for (int i = 0; i < 4; i++){ v += a * noise(p); p *= 2.02; a *= 0.5; }
			return v;
		}

		void main(){
			vec2 uv = gl_FragCoord.xy / r.xy;
			vec2 p = uv * vec2(r.x / r.y, 1.0) * 1.6;
			float tt = t * 0.045;
			p += (m - 0.5) * 0.25;

			vec2 q = vec2(fbm(p + tt), fbm(p + vec2(5.2, 1.3) - tt));
			float f = fbm(p + 2.2 * q + vec2(tt * 1.5, -tt));

			vec3 bg     = vec3(0.043, 0.047, 0.071);
			vec3 violet = vec3(0.42, 0.40, 0.95);
			vec3 sky    = vec3(0.45, 0.72, 1.0);
			vec3 mint   = vec3(0.45, 0.88, 0.62);

			vec3 col = mix(violet, sky, smoothstep(0.2, 0.8, q.x));
			col = mix(col, mint, smoothstep(0.55, 0.95, q.y) * 0.55);

			// Aurora lives in the upper part of the canvas and ripples horizontally.
			float y = uv.y + 0.12 * sin(uv.x * 3.0 + tt * 4.0);
			float band = smoothstep(0.40, 0.90, f) * smoothstep(0.30, 0.90, y);
			band = pow(band, 1.25);
			vec3 c = mix(bg, col, band * 0.9);

			float vig = smoothstep(1.3, 0.25, length(uv - vec2(0.5, 0.75)));
			c *= mix(0.45, 1.0, vig);
			c = mix(c, bg, smoothstep(0.5, 0.0, uv.y));
			gl_FragColor = vec4(c, 1.0);
		}
	`;

	function start(canvas: HTMLCanvasElement) {
		// failIfMajorPerformanceCaveat: no software-rendered WebGL — those devices keep the static gradient.
		const gl = canvas.getContext('webgl', { antialias: false, premultipliedAlpha: false, failIfMajorPerformanceCaveat: true, powerPreference: 'low-power' });
		if (!gl) return;

		const compile = (type: number, src: string) => {
			const s = gl.createShader(type)!;
			gl.shaderSource(s, src);
			gl.compileShader(s);
			return s;
		};
		const prog = gl.createProgram()!;
		gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
		gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
		gl.linkProgram(prog);
		if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
		gl.useProgram(prog);

		const buf = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buf);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		const loc = gl.getAttribLocation(prog, 'p');
		gl.enableVertexAttribArray(loc);
		gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

		const uR = gl.getUniformLocation(prog, 'r');
		const uT = gl.getUniformLocation(prog, 't');
		const uM = gl.getUniformLocation(prog, 'm');

		// Render at a fraction of device pixels — the shader is soft, so this is invisible and cheap.
		const scale = window.innerWidth < 768 ? 0.35 : 0.5;
		const resize = () => {
			const w = Math.max(1, Math.floor(canvas.clientWidth * scale));
			const h = Math.max(1, Math.floor(canvas.clientHeight * scale));
			if (canvas.width !== w || canvas.height !== h) {
				canvas.width = w;
				canvas.height = h;
				gl.viewport(0, 0, w, h);
			}
		};

		const mouse = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5 };
		window.addEventListener('pointermove', (e) => {
			mouse.tx = e.clientX / window.innerWidth;
			mouse.ty = 1 - e.clientY / window.innerHeight;
		}, { passive: true });

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let visible = true;
		let raf = 0;
		const t0 = performance.now();

		const frame = (now: number) => {
			resize();
			mouse.x += (mouse.tx - mouse.x) * 0.03;
			mouse.y += (mouse.ty - mouse.y) * 0.03;
			gl.uniform2f(uR, canvas.width, canvas.height);
			gl.uniform1f(uT, reduced ? 12 : (now - t0) / 1000);
			gl.uniform2f(uM, mouse.x, mouse.y);
			gl.drawArrays(gl.TRIANGLES, 0, 3);
			if (!reduced && visible) raf = requestAnimationFrame(frame);
		};

		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			cancelAnimationFrame(raf);
			if (visible) raf = requestAnimationFrame(frame);
		}).observe(canvas);

		raf = requestAnimationFrame(frame);
		canvas.style.opacity = '1';
	}

	// Start after load, in idle time, so the shader never competes with the initial render.
	const boot = () => document.querySelectorAll<HTMLCanvasElement>('canvas[data-aurora]').forEach(start);
	const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(boot, { timeout: 2000 }) : setTimeout(boot, 300));
	if (document.readyState === 'complete') idle();
	else window.addEventListener('load', idle, { once: true });
</script>
