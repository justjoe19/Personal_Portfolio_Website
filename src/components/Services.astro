---
const capabilities = [
	{ title: 'Brand & UI design', desc: 'Distinctive visual systems — type, color, motion — designed for your business, not pulled from a template.' },
	{ title: 'Motion & interaction', desc: 'Scroll-driven animation, WebGL, and micro-interactions that make a site feel alive without slowing it down.' },
	{ title: 'Performance', desc: 'Pre-rendered pages and minimal JavaScript, so sites load fast on any phone and any connection.' },
	{ title: 'Search & local SEO', desc: 'Semantic structure, schema markup, and location pages built in from the first commit.' },
	{ title: 'AI integration', desc: 'LLM-powered features that do real work: drafting, summarizing, and automating repetitive tasks.' },
	{ title: 'Accessibility', desc: 'Keyboard support, sensible contrast, and semantic HTML, so everyone can use what I build.' },
];

const check = '<svg class="mt-[3px] h-4 w-4 shrink-0 text-leaf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
---

<section id="services" class="relative border-t border-line py-24 sm:py-32">
	<div class="container-x">
		<div class="reveal max-w-3xl">
			<p class="eyebrow">Services</p>
			<h2 class="display mt-5 text-[clamp(2.4rem,5.4vw,4.4rem)]">
				Design and engineering, <span class="serif-accent text-gradient">under one roof.</span>
			</h2>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-body">
				You work directly with the person designing and writing your product, from the first sketch to launch day and beyond. No account managers, no handoffs, no templates.
			</p>
		</div>

		<div class="mt-16 grid gap-4 lg:grid-cols-6">
			<!-- Websites -->
			<article class="spotlight card reveal flex flex-col p-8 sm:p-10 lg:col-span-4 lg:row-span-2">
				<span class="font-mono text-xs text-muted">01</span>
				<h3 class="display mt-10 text-[clamp(2rem,3.6vw,3rem)]">Website Design &amp; Development</h3>
				<p class="mt-4 max-w-xl text-[1.05rem] leading-relaxed text-body">
					Custom, hand-built websites that look premium, load instantly, and turn visitors into customers. Every page is designed for your brand and built from scratch.
				</p>
				<ul class="mt-8 grid gap-3 text-[0.95rem] text-body sm:grid-cols-2">
					<li class="flex gap-3"><Fragment set:html={check} />Custom design system and motion</li>
					<li class="flex gap-3"><Fragment set:html={check} />Mobile-first and fast everywhere</li>
					<li class="flex gap-3"><Fragment set:html={check} />SEO and schema built in</li>
					<li class="flex gap-3"><Fragment set:html={check} />You own the finished site</li>
				</ul>
				<div class="my-8 grid grid-cols-3 gap-3" aria-hidden="true">
					<div class="flex aspect-[4/3] flex-col justify-between rounded-xl border border-line bg-night p-4">
						<span class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted">Type</span>
						<span class="text-4xl font-semibold tracking-tight text-ink">A<span class="serif-accent text-gradient">a</span></span>
					</div>
					<div class="flex aspect-[4/3] flex-col justify-between rounded-xl border border-line bg-night p-4">
						<span class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted">Color</span>
						<span class="flex -space-x-2">
							<span class="h-8 w-8 rounded-full border-2 border-night bg-sky"></span>
							<span class="h-8 w-8 rounded-full border-2 border-night bg-accent"></span>
							<span class="h-8 w-8 rounded-full border-2 border-night bg-leaf"></span>
							<span class="h-8 w-8 rounded-full border-2 border-night bg-ink"></span>
						</span>
					</div>
					<div class="flex aspect-[4/3] flex-col justify-between rounded-xl border border-line bg-night p-4">
						<span class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted">Motion</span>
						<svg viewBox="0 0 100 40" class="h-10 w-full" fill="none">
							<defs><linearGradient id="curve" x1="0" x2="1"><stop offset="0" stop-color="var(--color-sky)"/><stop offset="1" stop-color="var(--color-leaf)"/></linearGradient></defs>
							<path d="M2 38 C 40 38, 45 2, 98 2" stroke="url(#curve)" stroke-width="2.5" stroke-linecap="round"/>
						</svg>
					</div>
				</div>

				<dl class="mt-auto grid gap-px overflow-hidden rounded-xl border border-line bg-line pt-0 text-sm sm:grid-cols-2 [&>div]:bg-surface">
					<div class="p-4"><dt class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-muted">Built with</dt><dd class="mt-1.5 text-ink">Astro · React · TypeScript</dd></div>
					<div class="p-4"><dt class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-muted">Timeline</dt><dd class="mt-1.5 text-ink">Typically 2–4 weeks</dd></div>
				</dl>
			</article>

			<!-- Software -->
			<article class="spotlight card reveal flex flex-col p-8 lg:col-span-2">
				<span class="font-mono text-xs text-muted">02</span>
				<h3 class="mt-8 text-2xl font-semibold tracking-tight">Custom Software &amp; Products</h3>
				<p class="mt-3 leading-relaxed text-body">
					SaaS products, client portals, internal tools, and integrations. Real applications with accounts, roles, and data — like <a href="#rankradius" class="link-arrow">RankRadius</a>.
				</p>
				<p class="mt-auto pt-6 font-mono text-[0.72rem] text-muted">React · Node.js · Java / Spring Boot · SQL</p>
			</article>

			<!-- Hosting -->
			<article class="spotlight card reveal flex flex-col p-8 lg:col-span-2">
				<span class="font-mono text-xs text-muted">03</span>
				<h3 class="mt-8 text-2xl font-semibold tracking-tight">Hosting &amp; Maintenance</h3>
				<p class="mt-3 leading-relaxed text-body">
					I host your site and handle the small updates, so it never falls out of date.
				</p>
				<p class="mt-auto pt-6 font-mono text-[0.72rem] text-muted">SSL · Backups · Monthly updates</p>
			</article>
		</div>

		<ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{capabilities.map((c) => (
				<li class="spotlight card reveal p-6">
					<h3 class="font-semibold">{c.title}</h3>
					<p class="mt-2 text-[0.92rem] leading-relaxed text-muted">{c.desc}</p>
				</li>
			))}
		</ul>

		<p class="reveal mt-10 text-center text-body">
			Straightforward, upfront pricing for every service. <a href="#pricing" class="link-arrow">See pricing <span aria-hidden="true">→</span></a>
		</p>
	</div>
</section>
