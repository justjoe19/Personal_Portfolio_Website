<section id="about" class="border-t border-line py-24 sm:py-32" aria-labelledby="about-heading">
	<div class="container-x">
		<div class="reveal grid items-center gap-8 sm:grid-cols-[auto_1fr] sm:gap-12">
			<img
				src="/assets/photo.webp"
				alt="Joe Hollenbach, founder of Michiana Dev LLC"
				width="640"
				height="640"
				loading="lazy"
				class="aspect-square w-32 rounded-2xl border border-line object-cover grayscale-[25%] sm:w-44"
			/>
			<div class="max-w-2xl">
				<p class="eyebrow">About</p>
				<h2 id="about-heading" class="display mt-4 text-[clamp(2rem,4.4vw,3.2rem)]">A studio of one, <span class="serif-accent text-gradient">by design.</span></h2>
				<p class="mt-5 text-[1.05rem] leading-relaxed text-body">
					I’m Joe Hollenbach, a software engineer based in Mishawaka. I run Michiana Dev, and I design and build every site myself, so the person you talk to is the person doing the work.
				</p>
				<a href="/about" class="link-arrow mt-5 inline-block">More about me <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</div>
</section>
