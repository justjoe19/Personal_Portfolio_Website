---
const facts = [
	{ label: 'Based in', value: 'Mishawaka, IN' },
	{ label: 'Background', value: 'B.S. in Software Engineering' },
	{ label: 'How we work', value: '1-on-1 directly with Joe' },
];
---

<section id="about" class="border-t border-line py-24 sm:py-32" aria-labelledby="about-heading">
	<div class="container-x">
		<div class="reveal card grid items-center gap-8 p-7 sm:grid-cols-[auto_1fr] sm:gap-12 sm:p-10">
			<div class="flex flex-col items-center sm:items-start">
				<img
					src="/assets/photo.webp"
					alt="Joe Hollenbach, founder and software engineer at Michiana Dev LLC in Mishawaka, Indiana"
					width="640"
					height="640"
					loading="lazy"
					class="aspect-square w-36 rounded-2xl border border-line object-cover grayscale-[20%] sm:w-48"
				/>
				<p class="mt-3 text-xs text-muted">Joe Hollenbach · Mishawaka, IN</p>
			</div>

			<div class="max-w-3xl">
				<p class="eyebrow">Meet your developer</p>
				<h2 id="about-heading" class="display mt-4 text-[clamp(2rem,4.4vw,3.2rem)]">
					A local studio of one, <span class="serif-accent text-gradient">by design.</span>
				</h2>
				<p class="mt-5 text-[1.06rem] leading-relaxed text-body">
					I’m Joe Hollenbach, a software engineer based right here in Mishawaka. When you hire Michiana Dev, you don’t get handed off to a junior account rep or a template assembler—the person you talk to on the phone is the person designing, writing, and supporting your website.
				</p>

				<dl class="mt-6 grid gap-3 border-t border-line pt-6 sm:grid-cols-3">
					{facts.map((f) => (
						<div>
							<dt class="text-[0.66rem] uppercase tracking-[0.14em] text-muted">{f.label}</dt>
							<dd class="mt-1 text-sm font-semibold text-ink">{f.value}</dd>
						</div>
					))}
				</dl>

				<div class="mt-6 flex flex-wrap items-center gap-5">
					<a href="/about" class="link-arrow">More about me &amp; how I work <span aria-hidden="true">→</span></a>
					<a href="tel:+15742138502" class="text-sm text-muted hover:text-ink">Call (574) 213-8502</a>
				</div>
			</div>
		</div>
	</div>
</section>
