---
export interface FaqItem {
	q: string;
	a: string;
}

interface Props {
	faqs: FaqItem[];
	title?: string;
	id?: string;
	eyebrow?: string;
	showAllLink?: boolean;
}

const {
	faqs,
	title = 'Frequently asked questions',
	id = 'faq',
	eyebrow = 'FAQ',
	showAllLink = true,
} = Astro.props;
---

<section id={id} class="border-t border-line py-24 sm:py-32">
	<div class="container-x grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
		<div>
			<p class="eyebrow">{eyebrow}</p>
			<h2 class="display mt-5 text-[clamp(2.2rem,4.6vw,3.3rem)]">{title}</h2>
			<p class="mt-5 text-body">
				Don’t see your question? <a href="/contact" class="link-arrow">Send a message</a> or call <a href="tel:+15742138502" class="font-semibold text-ink hover:text-accent">(574) 213-8502</a>.
			</p>
			{showAllLink && (
				<p class="mt-4">
					<a href="/faq" class="link-arrow text-sm">Browse all FAQs <span aria-hidden="true">→</span></a>
				</p>
			)}
		</div>

		<dl class="divide-y divide-line border-t border-line-strong">
			{faqs.map((faq) => {
				const parts = faq.a.split('rankradius.io');
				return (
					<div class="py-7 first:pt-6">
						<dt class="text-[1.1rem] font-semibold leading-snug text-ink">{faq.q}</dt>
						<dd class="mt-3 max-w-2xl leading-relaxed text-body">
							{parts.map((part, idx) => (
								<>
									{part}
									{idx < parts.length - 1 && (
										<a href="https://rankradius.io" target="_blank" rel="noopener noreferrer" class="link-arrow">
											rankradius.io
										</a>
									)}
								</>
							))}
						</dd>
					</div>
				);
			})}
		</dl>
	</div>
</section>
