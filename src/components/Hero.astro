---
import { srcsetFor } from '../lib/images';
import ShaderBackground from './ShaderBackground.astro';

const stack = ['Astro', 'React', 'TypeScript', 'Tailwind CSS', 'Node.js', 'Java', 'Spring Boot', 'WebGL', 'Google Gemini', 'Serverless', 'View Transitions', 'Schema.org'];
---

<section id="top" class="relative overflow-hidden pt-36 sm:pt-44">
	<ShaderBackground />
	<div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(70%_60%_at_50%_30%,#000,transparent)]"></div>

	<div class="container-x relative text-center">
		<a href="#contact" class="group inline-flex items-center gap-2.5 rounded-full border border-line-strong bg-white/[0.04] py-1.5 pr-3 pl-2 text-[0.8rem] text-body backdrop-blur-md transition-colors hover:bg-white/[0.08]">
			<span class="flex items-center gap-1.5 rounded-full bg-leaf/15 px-2 py-0.5 font-mono text-[0.68rem] font-medium text-leaf">
				<span class="relative flex h-1.5 w-1.5"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-leaf opacity-70"></span><span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-leaf"></span></span>
				Open
			</span>
			Now taking new website &amp; software projects
			<span class="text-muted transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
		</a>

		<h1 class="display mx-auto mt-8 max-w-[15ch] text-[clamp(3rem,8.4vw,7rem)]">
			<span class="text-fade">Websites and software that feel</span> <span class="serif-accent text-gradient pr-2">world-class.</span>
		</h1>

		<p class="mx-auto mt-7 max-w-[40rem] text-[clamp(1.05rem,1.6vw,1.2rem)] leading-relaxed text-body">
			Michiana Dev is an independent design &amp; engineering studio. I build fast, distinctive websites and complete software products for businesses that want to lead their market.
		</p>

		<div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
			<a href="#contact" class="btn-primary">
				Start a project
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
			</a>
			<a href="/work" class="btn-ghost">View the work</a>
		</div>
	</div>

	<!-- Showcase: tilts back in 3D and flattens as it scrolls into view -->
	<div class="container-x relative mt-20 sm:mt-24">
		<div class="tilt-in relative mx-auto max-w-[1080px]">
			<div aria-hidden="true" class="absolute -inset-x-10 -top-10 bottom-0 -z-10 rounded-[3rem] bg-accent/25 blur-[90px]"></div>
			<div class="card overflow-hidden !rounded-[1.4rem] !bg-surface/80 p-2 sm:p-2.5">
				<div class="grid gap-2 sm:gap-2.5 md:grid-cols-[1.55fr_1fr]">
					<figure class="overflow-hidden rounded-xl border border-line bg-night">
						<div class="flex items-center gap-2 border-b border-line px-4 py-2.5">
							<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
							<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
							<span class="ml-3 truncate rounded-md bg-white/[0.05] px-3 py-1 font-mono text-[0.68rem] text-muted">jhclaim.com</span>
						</div>
						<img src="/assets/work/jhclaims.webp" srcset={srcsetFor('/assets/work/jhclaims.webp')} sizes="(min-width: 768px) 660px, 100vw" alt="JH Claims Solution website, designed and built by Michiana Dev" width="1600" height="1000" fetchpriority="high" loading="eager" class="block aspect-[16/10] w-full object-cover object-top" />
					</figure>

					<div class="grid gap-2 sm:gap-2.5">
						<!-- RankRadius widget mock -->
						<div class="rounded-xl border border-line bg-night p-4 text-left" aria-hidden="true">
							<div class="flex items-center justify-between">
								<span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-muted">RankRadius widget</span>
								<span class="flex items-center gap-1.5 font-mono text-[0.62rem] text-leaf"><span class="h-1.5 w-1.5 rounded-full bg-leaf"></span>Live</span>
							</div>
							<p class="mt-3 text-[0.92rem] font-medium leading-snug text-ink">Furnace replacement in River Park, Mishawaka</p>
							<p class="mt-1.5 text-[0.78rem] leading-relaxed text-muted">20-year-old unit swapped for a high-efficiency system before the first cold snap.</p>
							<p class="mt-2.5 text-[0.75rem] text-amber-300">★★★★★ <span class="text-muted">matched review</span></p>
						</div>

						<!-- Code card -->
						<div class="rounded-xl border border-line bg-night p-4 text-left font-mono text-[0.72rem] leading-[1.7]" aria-hidden="true">
							<p class="text-muted">// hero.astro</p>
							<p><span class="text-accent">const</span> <span class="text-ink">site</span> = <span class="text-sky">build</span>({'{'}</p>
							<p class="pl-4"><span class="text-ink">design</span>: <span class="text-leaf">'custom'</span>,</p>
							<p class="pl-4"><span class="text-ink">speed</span>: <span class="text-leaf">'instant'</span>,</p>
							<p class="pl-4"><span class="text-ink">templates</span>: <span class="text-accent">null</span>,</p>
							<p>{'}'});</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Technology marquee -->
	<div class="relative mt-20 border-y border-line py-6 sm:mt-28">
		<p class="sr-only">Technologies I work with: {stack.join(', ')}</p>
		<div class="mask-fade-x overflow-hidden" aria-hidden="true">
			<div class="flex w-max animate-marquee gap-12 pr-12 hover:[animation-play-state:paused]">
				{[...stack, ...stack].map((t) => (
					<span class="flex items-center gap-3 whitespace-nowrap font-mono text-[0.8rem] uppercase tracking-[0.16em] text-muted">
						<span class="text-gradient">//</span>{t}
					</span>
				))}
			</div>
		</div>
	</div>
</section>
